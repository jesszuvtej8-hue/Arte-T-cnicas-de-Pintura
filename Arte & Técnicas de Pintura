                technique: 'Encáustica sobre madera',
                description: 'Los célebres Retratos de Fayum en el Egipto romano demuestran una conservación cromática impresionante mediante cera caliente.',
                icon: 'fa-fire'
            },
            {
                year: 'Siglo XV (c. 1420)',
                title: 'La Revolución del Óleo Flamenco',
                epoch: 'renacimiento',
                technique: 'Pintura al Óleo',
                description: 'Jan van Eyck perfecciona la fórmula del óleo sobre tabla, permitiendo veladuras infinitas, luminosidad inédita y gran detallismo.',
                icon: 'fa-feather'
            },
            {
                year: '1508 - 1512',
                title: 'La Capilla Sixtina',
                epoch: 'renacimiento',
                technique: 'Buon Fresco',
                description: 'Miguel Ángel ejecuta en el techo del Vaticano una de las obras cumbres del Fresco monumental, trabajando directamente sobre el yeso húmedo.',
                icon: 'fa-archway'
            },
            {
                year: '1841',
                title: 'Invención del Tubo de Pintura',
                epoch: 'impresionismo',
                technique: 'Pintura En Plein Air (Aire libre)',
                description: 'John Goffe Rand patenta el tubo de estaño colapsable. Esto libera a los artistas del taller y permite el nacimiento del Impresionismo al aire libre.',
                icon: 'fa-box-archive'
            },
            {
                year: '1874',
                title: 'Primera Exposición Impresionista',
                epoch: 'impresionismo',
                technique: 'Impasto / Trazo rápido',
                description: 'Monet, Renoir y Degas rompen con la pintura académica utilizando pinceladas sueltas, yuxtaposición de color puro y luz natural.',
                icon: 'fa-sun'
            },
            {
                year: '1950',
                title: 'Surgimiento de las Pinturas Acrílicas',
                epoch: 'vanguardias',
                technique: 'Acrílico industrial/artístico',
                description: 'La síntesis de resinas sintéticas da origen al acrílico. Andy Warhol y Jackson Pollock adoptan nuevos soportes y rapidez en sus creaciones.',
                icon: 'fa-flask'
            }
        ];

        /* === PREGUNTAS DEL QUIZ === */
        const quizQuestions = [
            {
                question: '¿Qué buscas principalmente al crear una obra?',
                options: [
                    { text: 'Tiempo para mezclar suavemente y lograr realismo supremo', points: 'oleo' },
                    { text: 'Espontaneidad, ligereza y jugar con el agua', points: 'acuarela' },
                    { text: 'Secado rápido, intensidad de color y máxima versatilidad', points: 'acrilico' },
                    { text: 'Textura tridimensional que sobresalga físicamente del lienzo', points: 'impasto' }
                ]
            },
            {
                question: '¿Cuál es tu tolerancia a los olores de solventes e imprevistos?',
                options: [
                    { text: 'Me gustan los procesos rituales, no me importa usar esencias/aceites', points: 'oleo' },
                    { text: 'Prefiero limpiar todo solo con agua limpia de forma ecológica', points: 'acuarela' },
                    { text: 'Quiero trabajar rápido sin complicaciones químicas pesadas', points: 'acrilico' },
                    { text: 'Amo el tacto directo y usar espátulas o materiales densos', points: 'impasto' }
                ]
            },
            {
                question: '¿Qué acabado prefieres en la superficie terminada?',
                options: [
                    { text: 'Brillo profundo y capas luminosas translúcidas (veladuras)', points: 'oleo' },
                    { text: 'Mate, etéreo y sutil con transiciones de color orgánicas', points: 'acuarela' },
                    { text: 'Un acabado satinado o mate moderno y firme', points: 'acrilico' },
                    { text: 'Relieve marcado donde las sombras cambien con la luz de la habitación', points: 'impasto' }
                ]
            }
        ];

        let currentQuizIndex = 0;
        let quizScores = { oleo: 0, acuarela: 0, acrilico: 0, impasto: 0 };

        /* === FUNCIONES DE RENDERIZADO === */

        // Cargar Tarjetas de Técnicas
        function renderTechniques(items) {
            const grid = document.getElementById('techniquesGrid');
            grid.innerHTML = '';

            if (items.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-500">No se encontraron técnicas que coincidan con la búsqueda.</div>`;
                return;
            }

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = `glass-card rounded-2xl p-6 bg-white dark:bg-art-darkcard border border-gray-200 dark:border-gray-800 shadow-lg hover:shadow-2xl transition duration-300 flex flex-col justify-between group cursor-pointer`;
                card.onclick = () => openModal(item);

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-tr ${item.color} text-white flex items-center justify-center shadow-md group-hover:scale-110 transition duration-300">
                                <i class="fa-solid ${item.icon} text-xl"></i>
                            </div>
                            <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 font-medium">
                                <i class="fa-regular fa-clock mr-1"></i> Secado: ${item.speed}
                            </span>
                        </div>
                        <h3 class="font-serif text-xl font-bold mb-2 group-hover:text-art-terracotta dark:group-hover:text-art-gold transition">${item.title}</h3>
                        <p class="text-xs text-art-terracotta dark:text-art-gold font-semibold mb-3">Aglutinante: ${item.bind}</p>
                        <p class="text-gray-600 dark:text-gray-300 text-sm line-clamp-3 mb-4 leading-relaxed">${item.description}</p>
                    </div>
                    <div class="pt-4 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between text-xs text-gray-500">
                        <span><i class="fa-solid fa-paintbrush mr-1"></i> Ver detalles</span>
                        <i class="fa-solid fa-arrow-right text-art-terracotta dark:text-art-gold group-hover:translate-x-1 transition"></i>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Cargar Línea del Tiempo
        function renderTimeline(filter = 'all') {
            const container = document.getElementById('timelineContainer');
            container.innerHTML = '';

            const filteredData = filter === 'all' 
                ? timelineData 
                : timelineData.filter(item => item.epoch === filter);

            filteredData.forEach((item, idx) => {
                const isEven = idx % 2 === 0;
                const row = document.createElement('div');
                row.className = `mb-8 flex justify-between items-center w-full ${isEven ? 'md:flex-row-reverse' : ''} flex-col md:flex-row`;

                row.innerHTML = `
                    <div class="order-1 md:w-5/12"></div>
                    <div class="z-20 flex items-center order-1 bg-art-terracotta dark:bg-art-gold text-white shadow-xl w-10 h-10 rounded-full justify-center my-2 md:my-0">
                        <i class="fa-solid ${item.icon} text-sm"></i>
                    </div>
                    <div class="order-1 glass-card bg-white dark:bg-art-darkcard border border-gray-200 dark:border-gray-800 rounded-2xl shadow-md md:w-5/12 px-6 py-5 hover:shadow-xl transition">
                        <span class="text-xs font-bold text-art-terracotta dark:text-art-gold uppercase tracking-wider">${item.year}</span>
                        <h3 class="font-serif font-bold text-lg text-gray-900 dark:text-white mt-1">${item.title}</h3>
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mt-0.5">Técnica: ${item.technique}</p>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">${item.description}</p>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        // Filtros combinados de búsqueda
        function filterContent() {
            const searchVal = document.getElementById('searchInput').value.toLowerCase();
            const filtered = techniques.filter(tech => {
                return tech.title.toLowerCase().includes(searchVal) ||
                       tech.description.toLowerCase().includes(searchVal) ||
                       tech.bind.toLowerCase().includes(searchVal) ||
                       tech.historyFact.toLowerCase().includes(searchVal);
            });
            renderTechniques(filtered);
        }

        function setFilter(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-art-terracotta', 'text-white');
                btn.classList.add('border-gray-300', 'text-gray-600', 'dark:text-gray-300');
            });
            event.target.classList.add('active', 'bg-art-terracotta', 'text-white');
            event.target.classList.remove('border-gray-300', 'text-gray-600', 'dark:text-gray-300');

            if (category === 'all') {
                renderTechniques(techniques);
            } else {
                const filtered = techniques.filter(t => t.category.includes(category));
                renderTechniques(filtered);
            }
        }

        function filterTimeline(epoch) {
            document.querySelectorAll('.timeline-tab').forEach(btn => {
                btn.classList.remove('bg-art-lapislazuli', 'text-white');
                btn.classList.add('bg-white', 'dark:bg-art-darkbg', 'text-gray-600', 'dark:text-gray-300');
            });
            event.target.classList.add('bg-art-lapislazuli', 'text-white');
            event.target.classList.remove('bg-white', 'dark:bg-art-darkbg', 'text-gray-600', 'dark:text-gray-300');
            
            renderTimeline(epoch);
        }

        /* === QUIZ LOGIC === */
        function renderQuiz() {
            const container = document.getElementById('quizContainer');
            
            if (currentQuizIndex < quizQuestions.length) {
                const q = quizQuestions[currentQuizIndex];
                container.innerHTML = `
                    <div class="mb-6">
                        <div class="flex justify-between items-center mb-2 text-xs font-semibold text-gray-400">
                            <span>Pregunta ${currentQuizIndex + 1} de ${quizQuestions.length}</span>
                            <span>${Math.round(((currentQuizIndex) / quizQuestions.length) * 100)}% Completado</span>
                        </div>
                        <div class="w-full bg-gray-200 dark:bg-gray-700 h-2 rounded-full overflow-hidden">
                            <div class="bg-art-terracotta dark:bg-art-gold h-full transition-all duration-300" style="width: ${((currentQuizIndex) / quizQuestions.length) * 100}%"></div>
                        </div>
                    </div>
                    <h3 class="font-serif text-lg font-bold mb-6 text-gray-800 dark:text-gray-100">${q.question}</h3>
                    <div class="space-y-3">
                        ${q.options.map((opt, i) => `
                            <button onclick="answerQuiz('${opt.points}')" class="w-full text-left p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-art-terracotta dark:hover:border-art-gold hover:bg-art-terracotta/5 dark:hover:bg-art-gold/5 transition flex items-center justify-between group">
                                <span class="text-sm text-gray-700 dark:text-gray-200 font-medium">${opt.text}</span>
                                <i class="fa-solid fa-chevron-right text-xs text-gray-400 group-hover:text-art-terracotta dark:group-hover:text-art-gold"></i>
                            </button>
                        `).join('')}
                    </div>
                `;
            } else {
                // Calcular ganador
                let winner = 'oleo';
                let max = 0;
                for (const [key, val] of Object.entries(quizScores)) {
                    if (val > max) {
                        max = val;
                        winner = key;
                    }
                }
                const matchedTech = techniques.find(t => t.id === winner);

                container.innerHTML = `
                    <div class="text-center py-6">
                        <div class="w-20 h-20 rounded-full bg-gradient-to-tr ${matchedTech.color} text-white flex items-center justify-center mx-auto mb-4 text-3xl shadow-xl">
                            <i class="fa-solid ${matchedTech.icon}"></i>
                        </div>
                        <h3 class="font-serif text-2xl font-bold mb-2">¡Tu técnica ideal es: ${matchedTech.title}!</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 max-w-md mx-auto">${matchedTech.description}</p>
                        <div class="flex justify-center gap-4">
                            <button onclick="openModalById('${matchedTech.id}')" class="px-6 py-2.5 rounded-full bg-art-terracotta text-white text-xs font-semibold shadow hover:bg-art-sienna transition">Ver detalles completos</button>
                            <button onclick="resetQuiz()" class="px-6 py-2.5 rounded-full border border-gray-300 text-xs font-semibold hover:bg-gray-100 dark:hover:bg-gray-800 transition">Reiniciar Quiz</button>
                        </div>
                    </div>
                `;
            }
        }

        function answerQuiz(techKey) {
            quizScores[techKey] = (quizScores[techKey] || 0) + 1;
            currentQuizIndex++;
            renderQuiz();
        }

        function resetQuiz() {
            currentQuizIndex = 0;
            quizScores = { oleo: 0, acuarela: 0, acrilico: 0, impasto: 0 };
            renderQuiz();
        }

        /* === MODAL FUNCTIONS === */
        function openModal(tech) {
            const modal = document.getElementById('modal');
            const modalContent = document.getElementById('modalContent');

            modalContent.innerHTML = `
                <div class="p-6 sm:p-8">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-tr ${tech.color} text-white flex items-center justify-center shadow">
                                <i class="fa-solid ${tech.icon} text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-serif text-2xl font-bold">${tech.title}</h3>
                                <span class="text-xs text-art-terracotta dark:text-art-gold font-semibold">Aglutinante: ${tech.bind}</span>
                            </div>
                        </div>
                        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-white p-2 text-xl">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-6">${tech.description}</p>

                    <div class="space-y-4 mb-6">
                        <div class="p-4 rounded-xl bg-gray-50 dark:bg-art-darkbg/50 border border-gray-100 dark:border-gray-800">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2"><i class="fa-solid fa-boxes-packing mr-1"></i> Materiales Clave:</h4>
                            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-gray-700 dark:text-gray-300">
                                ${tech.materials.map(m => `<li class="flex items-center"><i class="fa-solid fa-check text-art-terracotta dark:text-art-gold mr-2"></i>${m}</li>`).join('')}
                            </ul>
                        </div>

                        <div class="p-4 rounded-xl bg-art-lapislazuli/5 dark:bg-art-lapislazuli/20 border border-art-lapislazuli/10">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-art-lapislazuli dark:text-art-gold mb-1"><i class="fa-solid fa-landmark mr-1"></i> Obra Emblemática:</h4>
                            <p class="text-sm font-serif font-bold text-gray-800 dark:text-gray-100">${tech.famousWork}</p>
                            <p class="text-xs text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">${tech.historyFact}</p>
                        </div>
                    </div>

                    <div class="text-right">
                        <button onclick="closeModal()" class="px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-xs font-semibold transition">Cerrar</button>
                    </div>
                </div>
            `;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
                modalContent.classList.add('scale-100');
            }, 10);
        }

        function openModalById(id) {
            const tech = techniques.find(t => t.id === id);
            if (tech) openModal(tech);
        }

        function closeModal() {
            const modal = document.getElementById('modal');
            const modalContent = document.getElementById('modalContent');

            modal.classList.add('opacity-0');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');

            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        /* === TEMA Y MODOS ESTÉTICOS === */
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
        }

        function toggleGlassMode() {
            document.body.classList.toggle('glass-mode');
            const isGlass = document.body.classList.contains('glass-mode');
            document.getElementById('glassStatus').innerText = isGlass ? 'On' : 'Off';
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Inicialización al cargar la página
        window.onload = function() {
            renderTechniques(techniques);
            renderTimeline('all');
            renderQuiz();

            // Cerrar modal al hacer clic fuera
            document.getElementById('modal').addEventListener('click', function(e) {
                if (e.target === this) closeModal();
            });
        };
    </script>
</body>
</html>
